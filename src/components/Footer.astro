---
import logo from "@public/logo.webp";
import { dashboardUrl, discordUrl } from "@constants/urls";
import Icon from "@icons/Icon.astro";

const columns = [
  {
    title: "Product",
    links: [
      { label: "Features", href: "#features" },
      { label: "Live demo", href: "#demo" },
      { label: "Pricing", href: "#pricing" },
      { label: "Dashboard", href: String(dashboardUrl), external: true },
    ],
  },
  {
    title: "Resources",
    links: [
      { label: "Sample builds", href: "#samples" },
      { label: "Compatibility", href: "#compatibility" },
      { label: "Reviews", href: "#reviews" },
      { label: "FAQ", href: "#faq" },
      { label: "Discord support", href: String(discordUrl), external: true },
    ],
  },
  {
    title: "Get started",
    links: [
      { label: "Get Nebula", href: String(discordUrl), external: true },
      { label: "Open dashboard", href: String(dashboardUrl), external: true },
      { label: "View plans", href: "#pricing" },
      { label: "Meet the pipeline", href: "#how-it-works" },
    ],
  },
];
---

<footer class="footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <a class="footer-logo" href="#home" aria-label="Nebula home">
        <span class="footer-mark">
          <img src={logo.src} alt="" width="32" height="32" />
        </span>
        <span>Nebula<small>Obfuscator</small></span>
      </a>
      <p>
        Layered Java bytecode protection for Minecraft plugins, mods and
        applications. Keep the code you worked for.
      </p>
      <div class="footer-social">
        <a
          href={String(discordUrl)}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Join the Nebula Discord"
        >
          <Icon name="chat" size={17} />
        </a>
        <a
          href={String(dashboardUrl)}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Open the Nebula dashboard"
        >
          <Icon name="terminal" size={17} />
        </a>
      </div>
    </div>

    {
      columns.map((column) => (
        <nav class="footer-col" aria-label={column.title}>
          <h4>{column.title}</h4>
          <ul>
            {column.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  target={link.external ? "_blank" : undefined}
                  rel={link.external ? "noopener noreferrer" : undefined}
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
  </div>

  <div class="footer-bottom">
    <span>© 2025–2026 Nebula Obfuscator. All rights reserved.</span>
    <span>Payments are handled through Discord.</span>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    z-index: 2;
    margin-top: 24px;
    border-top: 1px solid var(--border-subtle);
    background: rgba(8, 5, 15, 0.58);
  }

  .footer-inner {
    display: grid;
    grid-template-columns: 1.45fr repeat(3, 1fr);
    gap: 48px;
    width: 100%;
    max-width: var(--container);
    margin: 0 auto;
    padding: 64px 24px 48px;
  }

  .footer-brand {
    max-width: 320px;
  }

  .footer-logo {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    color: var(--text-primary);
  }

  .footer-mark {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 11px;
    background: linear-gradient(
      145deg,
      rgba(139, 92, 246, 0.28),
      rgba(217, 70, 239, 0.1)
    );
    border: 1px solid rgba(167, 139, 250, 0.26);
  }

  .footer-mark img {
    width: 26px;
    height: 26px;
    border-radius: 6px;
  }

  .footer-logo > span:last-child {
    display: flex;
    flex-direction: column;
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.05;
  }

  .footer-logo small {
    color: var(--text-muted);
    font-family: var(--font-body);
    font-size: 8.5px;
    font-weight: 600;
    letter-spacing: 0.24em;
    text-transform: uppercase;
  }

  .footer-brand p {
    margin-top: 18px;
    color: var(--text-muted);
    font-size: 12.5px;
    line-height: 1.7;
  }

  .footer-social {
    display: flex;
    gap: 8px;
    margin-top: 20px;
  }

  .footer-social a {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 10px;
    border: 1px solid var(--border-soft);
    background: rgba(255, 255, 255, 0.025);
    color: var(--text-secondary);
    transition:
      color 0.18s ease,
      border-color 0.18s ease,
      background 0.18s ease;
  }

  .footer-social a:hover {
    color: var(--accent-bright);
    border-color: var(--border-mid);
    background: var(--bg-hover);
  }

  .footer-col h4 {
    margin-bottom: 16px;
    color: var(--text-primary);
    font-family: var(--font-display);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .footer-col ul {
    display: flex;
    flex-direction: column;
    gap: 11px;
  }

  .footer-col a {
    color: var(--text-muted);
    font-size: 12.5px;
    transition: color 0.16s ease;
  }

  .footer-col a:hover {
    color: var(--accent-bright);
  }

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    width: 100%;
    max-width: var(--container);
    margin: 0 auto;
    padding: 20px 24px 28px;
    border-top: 1px solid var(--border-subtle);
    color: var(--text-muted);
    font-size: 11.5px;
  }

  @media (max-width: 860px) {
    .footer-inner {
      grid-template-columns: 1fr 1fr;
      gap: 36px;
      padding-top: 52px;
    }

    .footer-brand {
      grid-column: 1 / -1;
      max-width: 420px;
    }
  }

  @media (max-width: 540px) {
    .footer-inner {
      grid-template-columns: 1fr;
      gap: 30px;
    }

    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: 6px;
    }
  }
</style>
