---
import { discordUrl } from "@constants/urls";
import Icon from "@icons/Icon.astro";

const features = [
  "Class, field & method name renaming",
  "Annotation & resource encryption",
  "Constant exporting to file",
  "Control flow flattening",
  "Line number mangling",
  "Method inlining",
  "Number & string encryption",
  "Reference obfuscation",
  "Switch to if conversion",
  "Junk code insertion",
  "Code virtualization",
  "Miscellaneous obfuscations",
];

const plans = [
  {
    tier: "Standard",
    amount: "35",
    period: "6 months",
    months: 6,
    popular: false,
    summary: "Full protection for short-term or single-release projects.",
    button: "Get 6 months",
  },
  {
    tier: "Annual",
    amount: "60",
    period: "12 months",
    months: 12,
    popular: true,
    summary: "Best value for long-running, continuously updated projects.",
    button: "Get 12 months",
  },
];
---

<section class="section pricing" id="pricing">
  <div class="section-head animate-fade-slide-up">
    <span class="eyebrow">Pricing</span>
    <h2 class="section-title">One pipeline. Two ways to own it.</h2>
    <p class="section-sub">
      One-time payment, no subscription. Both plans unlock the complete Nebula
      protection pipeline — the only difference is how long your updates last.
    </p>
  </div>

  <div class="pricing-banner">
    <span>
      <Icon name="sparkles" size={15} />
      Every plan includes all 19 protection layers
    </span>
    <span class="banner-tag">Checkout via Discord</span>
  </div>

  <div class="pricing-grid">
    {
      plans.map((plan) => (
        <article class:list={["plan", { "plan--popular": plan.popular }]}>
          {plan.popular && <span class="plan-ribbon">Best value</span>}

          <div class="plan-head">
            <div class="plan-title-row">
              <h3>{plan.tier}</h3>
              <span class="plan-type">
                {plan.popular ? "Annual license" : "Starter license"}
              </span>
            </div>
            <p>{plan.summary}</p>
          </div>

          <div class="plan-price">
            <span class="plan-amount">
              <sup>$</sup>
              {plan.amount}
            </span>
            <span class="plan-period">/ {plan.period}</span>
          </div>

          <p class="plan-note">
            One-time payment · Free updates for {plan.months} months
          </p>

          <div class="plan-divider" />

          <ul class="plan-features">
            {features.map((feature) => (
              <li>
                <span class="plan-check">
                  <Icon name="check" size={11} />
                </span>
                {feature}
              </li>
            ))}
          </ul>

          <a
            class:list={[
              "btn",
              "plan-btn",
              plan.popular ? "btn-primary" : "btn-ghost",
            ]}
            href={String(discordUrl)}
            target="_blank"
            rel="noopener noreferrer"
          >
            {plan.button}
            <Icon name="arrow-right" size={15} />
          </a>
        </article>
      ))
    }
  </div>

  <p class="pricing-foot">
    Prices in USD. Payments are handled through Discord — need a custom
    arrangement or an invoice?
    <a
      href={String(discordUrl)}
      target="_blank"
      rel="noopener noreferrer">Talk to us there</a
    >.
  </p>
</section>

<style>
  .pricing-banner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    width: fit-content;
    max-width: 100%;
    margin: -24px auto 32px;
    padding: 8px 14px;
    border-radius: 999px;
    border: 1px solid rgba(167, 139, 250, 0.22);
    background: rgba(139, 92, 246, 0.08);
    color: var(--text-secondary);
    font-size: 11px;
  }

  .pricing-banner > span:first-child {
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }

  .pricing-banner :global(svg) {
    color: var(--accent-bright);
  }

  .banner-tag {
    padding: 3px 8px;
    border-radius: 999px;
    background: rgba(74, 222, 128, 0.1);
    border: 1px solid rgba(74, 222, 128, 0.2);
    color: var(--green);
    font-family: var(--font-mono);
    font-size: 8.5px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: stretch;
    gap: 22px;
    width: 100%;
    max-width: 920px;
    margin: 0 auto;
  }

  .plan {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 30px;
    border-radius: var(--radius-xl);
    border: 1px solid var(--border-subtle);
    background: linear-gradient(
      165deg,
      rgba(29, 19, 49, 0.72),
      rgba(11, 8, 20, 0.9)
    );
    box-shadow: var(--shadow-card);
    transition:
      transform 0.2s ease,
      border-color 0.2s ease;
  }

  .plan:hover {
    transform: translateY(-4px);
    border-color: var(--border-soft);
  }

  .plan--popular {
    border-color: rgba(167, 139, 250, 0.4);
    background:
      radial-gradient(
        ellipse at 50% 0%,
        rgba(139, 92, 246, 0.18),
        transparent 52%
      ),
      linear-gradient(165deg, rgba(34, 22, 57, 0.86), rgba(12, 8, 22, 0.94));
    box-shadow:
      0 30px 70px -32px rgba(139, 92, 246, 0.55),
      var(--shadow-card);
  }

  .plan--popular:hover {
    border-color: rgba(167, 139, 250, 0.6);
  }

  .plan-ribbon {
    position: absolute;
    top: 0;
    right: 30px;
    transform: translateY(-50%);
    padding: 6px 12px;
    border-radius: 999px;
    background: linear-gradient(135deg, #7c3aed, #a855f7 55%, #d946ef);
    color: #fff;
    font-size: 9.5px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    box-shadow: 0 8px 22px -8px rgba(168, 85, 247, 0.9);
  }

  .plan-title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }

  .plan-head h3 {
    color: var(--text-primary);
    font-family: var(--font-display);
    font-size: 1.28rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .plan-type {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 8.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .plan-head p {
    margin-top: 6px;
    color: var(--text-muted);
    font-size: 11.5px;
    line-height: 1.55;
  }

  .plan-price {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin-top: 24px;
  }

  .plan-amount {
    display: inline-flex;
    align-items: flex-start;
    color: var(--text-primary);
    font-family: var(--font-display);
    font-size: 3.4rem;
    font-weight: 700;
    letter-spacing: -0.055em;
    line-height: 0.9;
  }

  .plan-amount sup {
    margin-top: 7px;
    margin-right: 2px;
    color: var(--accent-soft);
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: 0;
  }

  .plan-period {
    color: var(--text-muted);
    font-size: 11.5px;
  }

  .plan-note {
    margin-top: 12px;
    color: var(--text-muted);
    font-size: 10.5px;
    line-height: 1.5;
  }

  .plan-divider {
    height: 1px;
    margin: 24px 0 20px;
    background: linear-gradient(
      90deg,
      var(--border-soft),
      var(--border-subtle) 60%,
      transparent
    );
  }

  .plan-features {
    display: grid;
    grid-template-columns: 1fr;
    gap: 9px;
    margin-bottom: 26px;
  }

  .plan-features li {
    display: flex;
    align-items: flex-start;
    gap: 9px;
    color: var(--text-secondary);
    font-size: 11.5px;
    line-height: 1.5;
  }

  .plan-check {
    display: grid;
    place-items: center;
    width: 17px;
    height: 17px;
    flex-shrink: 0;
    margin-top: 1px;
    border-radius: 50%;
    border: 1px solid rgba(74, 222, 128, 0.26);
    background: var(--green-dim);
    color: var(--green);
  }

  .plan-btn {
    width: 100%;
    margin-top: auto;
    padding: 13px 20px;
  }

  .pricing-foot {
    margin-top: 28px;
    text-align: center;
    color: var(--text-muted);
    font-size: 11.5px;
  }

  .pricing-foot a {
    color: var(--accent-bright);
    text-decoration: underline;
    text-decoration-color: rgba(196, 181, 253, 0.35);
    text-underline-offset: 3px;
    transition: color 0.16s ease;
  }

  .pricing-foot a:hover {
    color: var(--accent-pink);
  }

  @media (max-width: 820px) {
    .pricing-grid {
      grid-template-columns: 1fr;
      max-width: 480px;
    }
  }

  @media (max-width: 600px) {
    .plan {
      padding: 24px;
    }

    .plan-ribbon {
      right: 22px;
    }

    .plan-amount {
      font-size: 3rem;
    }

    .pricing-banner {
      flex-direction: column;
      gap: 6px;
      border-radius: 14px;
      margin-top: -16px;
    }
  }
</style>
