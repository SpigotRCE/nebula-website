---
import Icon from "@icons/Icon.astro";
import { discordUrl } from "@constants/urls";

const featureGroups = [
  {
    index: "01",
    category: "Identity & structure",
    features: [
      {
        icon: "layers",
        title: "Name Obfuscation",
        text: "Rename classes, fields and methods without destroying the hierarchy.",
      },
      {
        icon: "package",
        title: "Local Variable Table Obfuscation",
        text: "Pack every two local 32-bit integers into one 64-bit local long.",
      },
      {
        icon: "flow",
        title: "Method Inlining",
        text: "Inline eligible method calls to blur the call graph and its intent.",
      },
      {
        icon: "code",
        title: "Line Number Obfuscation",
        text: "Scramble line metadata so stack traces stop pointing back to source.",
      },
    ],
  },
  {
    index: "02",
    category: "Data & constants",
    features: [
      {
        icon: "lock",
        title: "String Encryption",
        text: "AES-CBC, SHA-256, MD5 and lookup tables hide string literals.",
      },
      {
        icon: "key",
        title: "Number Encryption",
        text: "Encrypt numeric constants with per-class salts.",
      },
      {
        icon: "package",
        title: "Constant Export & Encryption",
        text: "Export string constants into one encrypted resource file.",
      },
      {
        icon: "file-code",
        title: "Resource Encryption",
        text: "Encrypt, bundle and compress the resources inside your build.",
      },
      {
        icon: "tag",
        title: "Annotation Encryption",
        text: "Encrypt the strings and numbers stored inside annotations.",
      },
      {
        icon: "sparkles",
        title: "Method Salting",
        text: "Pass unique keys through method parameters on every call.",
      },
    ],
  },
  {
    index: "03",
    category: "Flow & references",
    features: [
      {
        icon: "flow",
        title: "Control Flow Flattening",
        text: "Flatten control flow and shuffle blocks to break logical structure.",
      },
      {
        icon: "flow",
        title: "Switch to Ifs",
        text: "Convert switch tables into nested branches that are harder to follow.",
      },
      {
        icon: "eye-off",
        title: "Reference Obfuscation",
        text: "Hide method and field references behind indirection.",
      },
      {
        icon: "alert",
        title: "Exception Flow Obfuscation",
        text: "Add dead exception handlers to trip up decompilers.",
      },
      {
        icon: "sparkles",
        title: "Useless Reference Injection",
        text: "Inject dead code and references that lead absolutely nowhere.",
      },
    ],
  },
  {
    index: "04",
    category: "Maximum security & fit",
    features: [
      {
        icon: "cpu",
        title: "Virtual Machine Protection",
        text: "Interpret selected code through a proprietary VM layer.",
      },
      {
        icon: "server",
        title: "Platform Support",
        text: "Paper, BungeeCord and Velocity support without breaking the build.",
      },
      {
        icon: "book",
        title: "Practical Documentation",
        text: "Guides for authentication, configuration and safer releases.",
      },
    ],
  },
];
---

<section class="section features" id="features">
  <div class="section-head animate-fade-slide-up">
    <span class="eyebrow">Protection layers</span>
    <h2 class="section-title">Defense at every layer of the bytecode.</h2>
    <p class="section-sub">
      Nebula does not stop at renaming. Every plan runs the complete pipeline —
      structure, constants, flow and a VM layer for the code that matters most.
    </p>
  </div>

  <div class="feature-groups">
    {
      featureGroups.map((group) => (
        <div class="feature-group">
          <div class="group-head">
            <span class="group-index">{group.index}</span>
            <h3>{group.category}</h3>
            <span class="group-line" />
            <span class="group-count">
              {group.features.length} layer{group.features.length > 1 ? "s" : ""}
            </span>
          </div>

          <div class="feature-grid">
            {group.features.map((feature) => (
              <article class="feature-card">
                <span class="feature-icon">
                  <Icon name={feature.icon} size={18} />
                </span>
                <h4>{feature.title}</h4>
                <p>{feature.text}</p>
              </article>
            ))}
          </div>
        </div>
      ))
    }
  </div>

  <div class="features-note">
    <p>
      Every layer is configurable. Start from a preset, then tune the pipeline to
      the way your project actually ships.
    </p>
    <a
      class="note-link"
      href={String(discordUrl)}
      target="_blank"
      rel="noopener noreferrer"
    >
      Ask us what fits your build
      <Icon name="arrow-right" size={14} />
    </a>
  </div>
</section>

<style>
  .features {
    padding-top: 64px;
  }

  .feature-groups {
    display: flex;
    flex-direction: column;
    gap: 52px;
  }

  .group-head {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 18px;
  }

  .group-index {
    color: var(--accent-soft);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.08em;
  }

  .group-head h3 {
    color: var(--accent-bright);
    font-family: var(--font-display);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .group-line {
    flex: 1;
    height: 1px;
    background: linear-gradient(
      90deg,
      rgba(167, 139, 250, 0.24),
      rgba(167, 139, 250, 0.03)
    );
  }

  .group-count {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  .feature-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
  }

  .feature-card {
    position: relative;
    padding: 22px;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-subtle);
    background: linear-gradient(
      160deg,
      rgba(32, 21, 54, 0.56),
      rgba(13, 9, 23, 0.72)
    );
    box-shadow: var(--shadow-card);
    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      background 0.2s ease;
  }

  .feature-card:hover {
    transform: translateY(-3px);
    border-color: rgba(167, 139, 250, 0.32);
    background: linear-gradient(
      160deg,
      rgba(40, 26, 67, 0.66),
      rgba(15, 10, 26, 0.8)
    );
  }

  .feature-icon {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 10px;
    border: 1px solid rgba(167, 139, 250, 0.2);
    background: var(--accent-dim);
    color: var(--accent-bright);
  }

  .feature-card h4 {
    margin-top: 16px;
    color: var(--text-primary);
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  .feature-card p {
    margin-top: 7px;
    color: var(--text-muted);
    font-size: 11.5px;
    line-height: 1.65;
  }

  .features-note {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    margin-top: 52px;
    padding: 22px 26px;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-subtle);
    background: rgba(19, 13, 31, 0.55);
  }

  .features-note p {
    max-width: 620px;
    color: var(--text-secondary);
    font-size: 12.5px;
    line-height: 1.65;
  }

  .note-link {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    flex-shrink: 0;
    color: var(--accent-bright);
    font-size: 12px;
    font-weight: 600;
    transition: color 0.18s ease;
  }

  .note-link:hover {
    color: var(--accent-pink);
  }

  @media (max-width: 940px) {
    .feature-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 620px) {
    .feature-grid {
      grid-template-columns: 1fr;
    }

    .group-head {
      gap: 10px;
    }

    .group-count {
      display: none;
    }

    .features-note {
      flex-direction: column;
      align-items: flex-start;
      gap: 14px;
      padding: 20px;
    }
  }
</style>
