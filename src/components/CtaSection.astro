---
import { discordUrl } from "@constants/urls";
import Icon from "@icons/Icon.astro";

const meta = ["One-time payment", "All 19 layers", "Paper & Velocity ready"];
---

<section class="section cta">
  <div class="cta-card">
    <div class="cta-orbit" aria-hidden="true"></div>

    <span class="eyebrow">Get Nebula</span>
    <h2 class="section-title cta-title">
      Your code doesn't have to<br class="cta-break" />
      ship readable.
    </h2>
    <p class="cta-sub">
      Protect your next release with the full Nebula pipeline — or download a
      real protected sample and judge the output yourself.
    </p>

    <div class="cta-actions">
      <a
        class="btn btn-primary btn-lg"
        href={String(discordUrl)}
        target="_blank"
        rel="noopener noreferrer"
      >
        Get started on Discord
        <Icon name="arrow-right" size={16} />
      </a>
      <a class="btn btn-ghost btn-lg" href="#samples">Download samples</a>
    </div>

    <div class="cta-meta">
      {
        meta.map((item) => (
          <span>
            <Icon name="check" size={13} />
            {item}
          </span>
        ))
      }
    </div>
  </div>
</section>

<style>
  .cta {
    padding-top: 40px;
    padding-bottom: 96px;
  }

  .cta-card {
    position: relative;
    overflow: hidden;
    padding: 72px 32px;
    border-radius: 28px;
    border: 1px solid rgba(167, 139, 250, 0.26);
    background:
      radial-gradient(
        ellipse at 50% 0%,
        rgba(168, 85, 247, 0.26),
        transparent 58%
      ),
      linear-gradient(165deg, rgba(35, 22, 60, 0.9), rgba(10, 7, 18, 0.96));
    box-shadow:
      0 50px 120px -50px rgba(139, 92, 246, 0.6),
      inset 0 1px 0 rgba(255, 255, 255, 0.06);
    text-align: center;
  }

  .cta-card::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(196, 181, 253, 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(196, 181, 253, 0.04) 1px, transparent 1px);
    background-size: 44px 44px;
    mask-image: radial-gradient(ellipse at 50% 30%, #000, transparent 70%);
    -webkit-mask-image: radial-gradient(
      ellipse at 50% 30%,
      #000,
      transparent 70%
    );
    pointer-events: none;
  }

  .cta-orbit {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 760px;
    height: 760px;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    border: 1px solid rgba(167, 139, 250, 0.08);
    box-shadow:
      0 0 0 90px rgba(167, 139, 250, 0.04),
      0 0 0 180px rgba(167, 139, 250, 0.025);
    pointer-events: none;
  }

  .cta-card > :not(.cta-orbit) {
    position: relative;
    z-index: 1;
  }

  .cta-title {
    margin-top: 20px;
    font-size: clamp(2rem, 5vw, 3.6rem);
  }

  .cta-sub {
    max-width: 560px;
    margin: 18px auto 0;
    color: var(--text-secondary);
    font-size: 13.5px;
    line-height: 1.75;
  }

  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 30px;
  }

  .cta-meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 20px;
    margin-top: 28px;
  }

  .cta-meta span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--text-muted);
    font-size: 10.5px;
  }

  .cta-meta :global(svg) {
    color: var(--green);
  }

  @media (max-width: 600px) {
    .cta {
      padding-bottom: 72px;
    }

    .cta-card {
      padding: 52px 20px;
      border-radius: 22px;
    }

    .cta-break {
      display: none;
    }

    .cta-sub {
      font-size: 12.5px;
    }

    .cta-actions {
      flex-direction: column;
      align-items: stretch;
    }

    .cta-meta {
      gap: 10px 18px;
    }
  }
</style>
