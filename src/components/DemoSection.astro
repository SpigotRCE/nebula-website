---
import Prism from "prismjs";
import "prismjs/components/prism-java.js";
import "@styles/prism-nebula.css";

import Icon from "@icons/Icon.astro";
import { samples } from "@constants/urls";
import {
  originalCode,
  obfuscatedCode,
  virtualizedCode,
} from "@constants/javaCode";

const grammar = Prism.languages.java ?? Prism.languages.clike;

const tabs = [
  {
    id: "original",
    label: "Original",
    file: "Example.java",
    code: originalCode,
  },
  {
    id: "obfuscated",
    label: "Obfuscated",
    file: "Example.class",
    code: obfuscatedCode,
  },
  {
    id: "virtualized",
    label: "Virtualized",
    file: "Example.class",
    code: virtualizedCode,
  },
].map((tab) => ({
  ...tab,
  html: Prism.highlight(tab.code, grammar, "java"),
}));
---

<section class="section demo" id="demo">
  <div class="section-head animate-fade-slide-up">
    <span class="eyebrow">Live example</span>
    <h2 class="section-title">See the transformation.</h2>
    <p class="section-sub">
      Three views of the same class: readable, obfuscated and virtualized. No
      hand-waving — switch tabs and read the difference yourself.
    </p>
  </div>

  <div class="demo-shell">
    <div class="demo-bar">
      <span class="traffic" aria-hidden="true">
        <i></i><i></i><i></i>
      </span>
      <span class="demo-file mono" id="demo-file">Example.java</span>
      <button class="copy-btn" id="copy-code" type="button">
        <Icon name="copy" size={14} />
        <span>Copy</span>
      </button>
    </div>

    <div class="demo-tabs" role="tablist" aria-label="Code examples">
      {
        tabs.map((tab, index) => (
          <button
            class:list={["demo-tab", { "is-active": index === 0 }]}
            id={`tab-${tab.id}`}
            type="button"
            role="tab"
            aria-selected={index === 0}
            aria-controls={`panel-${tab.id}`}
            tabindex={index === 0 ? 0 : -1}
            data-tab={tab.id}
            data-file={tab.file}
          >
            {tab.label}
          </button>
        ))
      }
    </div>

    <div class="demo-panels">
      {
        tabs.map((tab, index) => (
          <div
            class="demo-panel"
            id={`panel-${tab.id}`}
            role="tabpanel"
            aria-labelledby={`tab-${tab.id}`}
            data-panel={tab.id}
            hidden={index !== 0}
          >
            <pre class="code-block"><code
                class="language-java"
                set:html={tab.html}
              /></pre>
          </div>
        ))
      }
    </div>
  </div>

  <div class="samples" id="samples">
    <div class="samples-head">
      <div>
        <h3>Test it yourself</h3>
        <p>
          Real builds, before and after Nebula. Grab a sample and inspect the
          output before you spend anything.
        </p>
      </div>
      <span class="samples-badge">
        <Icon name="package" size={14} />
        JAR samples
      </span>
    </div>

    <div class="sample-list">
      {
        samples.map((sample) => (
          <div class="sample-row">
            <span class="sample-name">
              <Icon name="package" size={15} />
              {sample.name}
            </span>

            <span class="sample-links">
              {sample.originalUrl ? (
                <a
                  class="sample-link"
                  href={sample.originalUrl}
                  download
                  rel="noopener noreferrer"
                >
                  Original
                  <Icon name="download" size={13} />
                </a>
              ) : (
                <span class="sample-na">No original</span>
              )}
              {sample.protectedUrl ? (
                <a
                  class="sample-link sample-link--protected"
                  href={sample.protectedUrl}
                  download
                  rel="noopener noreferrer"
                >
                  Protected
                  <Icon name="download" size={13} />
                </a>
              ) : (
                <span class="sample-na">Not available</span>
              )}
            </span>

            <span class="sample-info">
              {sample.info}
              {sample.githubUrl && (
                <a
                  class="sample-source"
                  href={sample.githubUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  View source
                  <Icon name="arrow-right" size={12} />
                </a>
              )}
            </span>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .demo-shell {
    overflow: hidden;
    border-radius: var(--radius-xl);
    border: 1px solid var(--border-soft);
    background: #080510;
    box-shadow:
      var(--shadow-raised),
      inset 0 1px 0 rgba(255, 255, 255, 0.04);
  }

  .demo-bar {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--border-subtle);
    background: rgba(255, 255, 255, 0.022);
  }

  .traffic {
    display: flex;
    gap: 6px;
  }

  .traffic i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: rgba(196, 181, 253, 0.24);
  }

  .traffic i:nth-child(2) {
    background: rgba(232, 121, 249, 0.4);
  }

  .traffic i:nth-child(3) {
    background: rgba(139, 92, 246, 0.55);
  }

  .demo-file {
    color: var(--text-muted);
    font-size: 10.5px;
    letter-spacing: 0.02em;
  }

  .copy-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-left: auto;
    padding: 6px 11px;
    border-radius: 8px;
    border: 1px solid var(--border-subtle);
    background: rgba(255, 255, 255, 0.025);
    color: var(--text-secondary);
    font-size: 10.5px;
    font-weight: 500;
    transition:
      color 0.16s ease,
      border-color 0.16s ease,
      background 0.16s ease;
  }

  .copy-btn:hover {
    color: var(--text-primary);
    border-color: var(--border-soft);
    background: var(--bg-hover);
  }

  .copy-btn.is-copied {
    color: var(--green);
    border-color: rgba(74, 222, 128, 0.28);
    background: rgba(74, 222, 128, 0.07);
  }

  .demo-tabs {
    display: flex;
    gap: 5px;
    padding: 10px 12px;
    overflow-x: auto;
    border-bottom: 1px solid var(--border-subtle);
    background: rgba(255, 255, 255, 0.012);
    scrollbar-width: none;
  }

  .demo-tabs::-webkit-scrollbar {
    display: none;
  }

  .demo-tab {
    padding: 8px 15px;
    border-radius: 8px;
    border: 1px solid transparent;
    color: var(--text-muted);
    font-size: 11.5px;
    font-weight: 600;
    white-space: nowrap;
    transition:
      color 0.16s ease,
      background 0.16s ease,
      border-color 0.16s ease;
  }

  .demo-tab:hover {
    color: var(--text-secondary);
    background: rgba(255, 255, 255, 0.025);
  }

  .demo-tab.is-active {
    color: var(--text-primary);
    background: var(--accent-dim);
    border-color: rgba(167, 139, 250, 0.24);
  }

  .demo-panels {
    position: relative;
  }

  .demo-panel[hidden] {
    display: none;
  }

  .code-block {
    max-height: 540px;
    margin: 0;
    padding: 22px 24px;
    overflow: auto;
    background: transparent !important;
    font-family: var(--font-mono);
    font-size: 12.5px;
    line-height: 1.75;
    tab-size: 4;
    white-space: pre;
  }

  .code-block::-webkit-scrollbar {
    width: 10px;
    height: 10px;
  }

  .code-block::-webkit-scrollbar-track {
    background: rgba(255, 255, 255, 0.02);
  }

  .code-block::-webkit-scrollbar-thumb {
    border: 2px solid #080510;
    border-radius: 6px;
    background: rgba(139, 92, 246, 0.4);
  }

  .samples {
    margin-top: 28px;
    scroll-margin-top: calc(var(--nav-height) + 24px);
    overflow: hidden;
    border-radius: var(--radius-xl);
    border: 1px solid var(--border-subtle);
    background: rgba(15, 10, 25, 0.62);
  }

  .samples-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 20px 22px;
    border-bottom: 1px solid var(--border-subtle);
  }

  .samples-head h3 {
    color: var(--text-primary);
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 600;
  }

  .samples-head p {
    max-width: 560px;
    margin-top: 3px;
    color: var(--text-muted);
    font-size: 11.5px;
    line-height: 1.6;
  }

  .samples-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    flex-shrink: 0;
    padding: 6px 10px;
    border-radius: 999px;
    border: 1px solid var(--border-soft);
    background: rgba(255, 255, 255, 0.025);
    color: var(--text-secondary);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .sample-list {
    display: flex;
    flex-direction: column;
  }

  .sample-row {
    display: grid;
    grid-template-columns: 150px 250px 1fr;
    align-items: center;
    gap: 20px;
    padding: 15px 22px;
    border-bottom: 1px solid var(--border-subtle);
    transition: background 0.16s ease;
  }

  .sample-row:last-child {
    border-bottom: 0;
  }

  .sample-row:hover {
    background: rgba(255, 255, 255, 0.02);
  }

  .sample-name {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--text-primary);
    font-family: var(--font-mono);
    font-size: 11.5px;
    font-weight: 500;
  }

  .sample-name :global(svg) {
    color: var(--accent-soft);
  }

  .sample-links {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .sample-link {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 6px 10px;
    border-radius: 7px;
    border: 1px solid var(--border-soft);
    color: var(--text-secondary);
    font-size: 10.5px;
    font-weight: 500;
    transition:
      color 0.16s ease,
      border-color 0.16s ease,
      background 0.16s ease;
  }

  .sample-link:hover {
    color: var(--text-primary);
    border-color: var(--border-mid);
    background: var(--bg-hover);
  }

  .sample-link--protected {
    border-color: rgba(167, 139, 250, 0.28);
    background: var(--accent-dim);
    color: var(--accent-bright);
  }

  .sample-link--protected:hover {
    color: #fff;
    border-color: rgba(167, 139, 250, 0.45);
    background: rgba(139, 92, 246, 0.22);
  }

  .sample-na {
    color: var(--text-muted);
    font-size: 10px;
    opacity: 0.8;
  }

  .sample-info {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    color: var(--text-muted);
    font-size: 11px;
    line-height: 1.5;
  }

  .sample-source {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    flex-shrink: 0;
    color: var(--accent-soft);
    font-size: 10px;
    font-weight: 500;
    transition: color 0.16s ease;
  }

  .sample-source:hover {
    color: var(--accent-bright);
  }

  @media (max-width: 860px) {
    .sample-row {
      grid-template-columns: 1fr;
      gap: 10px;
      padding: 16px 18px;
    }

    .sample-info {
      justify-content: flex-start;
      flex-wrap: wrap;
    }
  }

  @media (max-width: 600px) {
    .code-block {
      padding: 18px;
      font-size: 11.5px;
    }

    .samples-head {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
      padding: 18px;
    }

    .demo-bar {
      padding: 10px 12px;
    }

    .copy-btn span {
      display: none;
    }
  }
</style>

<script>
  const tabButtons = Array.from(
    document.querySelectorAll<HTMLButtonElement>(".demo-tab"),
  );
  const panels = Array.from(
    document.querySelectorAll<HTMLElement>(".demo-panel"),
  );
  const fileLabel = document.getElementById("demo-file");
  const copyButton = document.getElementById("copy-code");

  const activateTab = (id: string): void => {
    tabButtons.forEach((button) => {
      const active = button.dataset.tab === id;
      button.classList.toggle("is-active", active);
      button.setAttribute("aria-selected", String(active));
      button.tabIndex = active ? 0 : -1;
      if (active) {
        if (fileLabel) fileLabel.textContent = button.dataset.file ?? "";
      }
    });

    panels.forEach((panel) => {
      panel.hidden = panel.dataset.panel !== id;
    });
  };

  tabButtons.forEach((button) => {
    button.addEventListener("click", () => {
      if (button.dataset.tab) activateTab(button.dataset.tab);
    });
  });

  const tabList = document.querySelector(".demo-tabs");
  tabList?.addEventListener("keydown", (event) => {
    if (!(event instanceof KeyboardEvent)) return;
    if (event.key !== "ArrowRight" && event.key !== "ArrowLeft") return;

    event.preventDefault();
    const currentIndex = tabButtons.findIndex((button) =>
      button.classList.contains("is-active"),
    );
    const direction = event.key === "ArrowRight" ? 1 : -1;
    const nextIndex =
      (currentIndex + direction + tabButtons.length) % tabButtons.length;
    const next = tabButtons[nextIndex];

    if (next?.dataset.tab) {
      activateTab(next.dataset.tab);
      next.focus();
    }
  });

  copyButton?.addEventListener("click", async () => {
    const activePanel = panels.find((panel) => !panel.hidden);
    const code = activePanel?.querySelector("code")?.textContent ?? "";
    const label = copyButton.querySelector("span");

    try {
      await navigator.clipboard.writeText(code);
    } catch {
      const textarea = document.createElement("textarea");
      textarea.value = code;
      textarea.style.position = "fixed";
      textarea.style.opacity = "0";
      document.body.appendChild(textarea);
      textarea.select();
      document.execCommand("copy");
      textarea.remove();
    }

    copyButton.classList.add("is-copied");
    if (label) label.textContent = "Copied";

    window.setTimeout(() => {
      copyButton.classList.remove("is-copied");
      if (label) label.textContent = "Copy";
    }, 1600);
  });
</script>
